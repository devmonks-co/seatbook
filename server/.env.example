DATABASE_URL=postgresql://seatbook:seatbook@localhost:5433/seatbook
PORT=4000
# Required, at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:5173
# Set to the number of reverse proxies in front of the API (e.g. 1) in production
# TRUST_PROXY=1
# Database the integration tests wipe and use (never point this at real data)
TEST_DATABASE_URL=postgresql://seatbook:seatbook@localhost:5433/seatbook_test
